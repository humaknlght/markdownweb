{
  "name": "markdown-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side Markdown previewer",
  "scripts": {
    "dev": "node scripts/serve.mjs src 3456",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 3456",
    "update:cdn-sri": "node scripts/cdn-integrity.mjs",
    "test": "node --test 'test/unit/*.test.js' 'test/scripts/*.test.js'",
    "test:e2e": "playwright test",
    "test:build": "RUN_BUILD_TESTS=1 node --test 'test/build/*.test.js'",
    "test:all": "npm test && npm run test:e2e && npm run test:build"
  },
  "devDependencies": {
    "@gfx/zopfli": "^1.0.15",
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.8.9",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^26.1.0",
    "marked": "^18.0.13",
    "playwright": "^1.55.1",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "gemoji": "^8.1.0",
    "yaml": "^2.9.1"
  }
}
