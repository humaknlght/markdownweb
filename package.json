{
  "name": "markdown-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side Markdown editor",
  "scripts": {
    "dev": "node scripts/serve.mjs src 3456",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 3456",
    "update:cdn-sri": "node scripts/cdn-integrity.mjs",
    "test": "node --test 'test/unit/*.test.js' 'test/scripts/*.test.js'",
    "test:e2e": "playwright test",
    "test:build": "RUN_BUILD_TESTS=1 node --test 'test/build/*.test.js'",
    "test:all": "npm test && npm run test:e2e && npm run test:build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@gfx/zopfli": "^1.0.15",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.12.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "marked": "^18.1.1",
    "playwright": "~1.61.1",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "gemoji": "^8.1.0",
    "yaml": "^2.9.1"
  }
}
