# Mermaid renderer iframe — isolated from the app root .htaccess.
# Deployed as dist/mermaid-sandbox/.htaccess. Own directory so parent
# FilesMatch "\.html" COEP/CSP cannot win via mod_headers merge order.
# The CSP `sandbox allow-scripts` directive gives this page an opaque origin:
# Mermaid / svg2roughjs never run with the app's origin, storage, or DOM.

# The app index.html points at index.<content-hash>.html. That file is
# immutable. An unhashed index.html (dev) still revalidates.
DirectoryIndex index.html
DirectorySlash On

<IfModule mod_headers.c>
  Header set Cross-Origin-Resource-Policy "same-origin"
  Header append Vary "Accept-Encoding"

  # Must match the embedder (main app COEP require-corp).
  Header unset Cross-Origin-Embedder-Policy
  Header always unset Cross-Origin-Embedder-Policy
  Header always set Cross-Origin-Embedder-Policy "require-corp"

  Header unset Link
  Header always unset Link
  Header unset Speculation-Rules
  Header always unset Speculation-Rules

  Header unset Content-Security-Policy
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "__MERMAID_SANDBOX_CSP__"

  <FilesMatch "^index\.[a-f0-9]{8}\.html(\.(br|gz))?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html(\.(br|gz))?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header set Strict-Transport-Security "max-age=31536000"
</IfModule>
